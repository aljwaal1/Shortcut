<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
    </queries>

    <application android:allowBackup="true" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.Shortcut">
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService" android:enabled="false" android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
        <service android:name=".tools.ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <!-- Standard build intentionally does NOT register an AccessibilityService. -->

        <receiver android:name=".scheduler.ScheduledAppLaunchReceiver" android:exported="false" />
        <receiver android:name=".scheduler.ScheduledMessageReceiver" android:exported="false" />
        <receiver android:name=".scheduler.RestoreSchedulesReceiver" android:enabled="true" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".automation.BatteryCheckReceiver" android:exported="false" />
        <receiver android:name=".automation.ChargerEventReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity android:name=".automation.BatterySetupActivity" android:exported="false" />
        <activity android:name=".automation.CarModeActivity" android:exported="false" />
        <activity android:name=".automation.ParkedCarActivity" android:exported="false" />
        <activity android:name=".usage.AppUsageActivity" android:exported="false" />
        <activity android:name=".tools.NfcSetupActivity" android:exported="false" />
        <activity android:name=".tools.ScreenCaptureActivity" android:exported="false" />
        <activity android:name=".tools.ImageBatchActivity" android:exported="false" />
        <activity android:name=".tools.QuickFileActivity" android:exported="false" />
        <activity android:name=".tools.ImageCropActivity" android:exported="false" />
        <activity android:name=".tools.JpegConvertActivity" android:exported="false" />
        <activity android:name=".tools.MultiUrlPdfActivity" android:exported="false" />
        <activity android:name=".tools.ToolActivity" android:exported="false" />

        <activity android:name=".tools.NfcDispatchActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shortcut" android:host="tool" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
